[Unit]
Description=Sosyal İmece Orchestrator API Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sosyal-imece
Environment="PATH=/home/ubuntu/sosyal-imece/venv/bin"
ExecStart=/home/ubuntu/sosyal-imece/venv/bin/python orchestrator_api.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sosyal-imece

[Install]
WantedBy=multi-user.target
